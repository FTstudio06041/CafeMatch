# 忽略 Python 編譯檔
__pycache__/
*.pyc

# 忽略虛擬環境 (如果您的虛擬環境叫 venv 或 env)
venv/
env/
.venv/

# 忽略敏感資料
.env
.env.backup*
.env.*.bak

# 忽略 VS Code 設定檔
.vscode/

node_modules/

# 忽略作業系統縮圖
.DS_Store
Thumbs.db

# 忽略大型資料庫備份與 SQL 檔
*.sql
*.bak
backups/

# 忽略 Vite 日誌
vite-*.log

# 忽略系統日誌
*.log
api_error.log

# 忽略 AI 代理 / 開發過程暫存檔
tool_calls.txt
temp_*.txt
opus_report.txt